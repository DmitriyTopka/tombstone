{
  "version": "v1",
  "hooks": [
    {
      "name": "tombstone-post-tool",
      "description": "Tombstone: track tasks.md checkbox edits",
      "trigger": "PostToolUse",
      "action": {
        "type": "command",
        "command": "'/path/to/python' -m tombstone hook post-tool --project '/path/to/project'",
        "timeout": 10
      }
    }
  ]
}
